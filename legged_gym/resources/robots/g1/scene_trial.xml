<mujoco model="g1 scene">

  <include file="g1_29dof_rev_1_0_custom_backup.xml"/>

  <statistic center="1.0 0.7 1.0" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0.9 0.9 0.9"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-140" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="flat" rgb1="0 0 0" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <!-- A large ground plane with friction and restitution parameters.
         The friction attribute is defined as "static dynamic torsional".
         Here, friction="1.0 1.0 0.0" means static and dynamic friction of 1.0 and no torsional friction.
         The restitution attribute controls the bounciness.
         You can adjust these numbers to match your configuration.
    -->
    <geom name="ground" type="plane" pos="0 0 0" size="100 100 0.1"
          friction="1.0 1.0 0.0" solref="-1000 -1000" rgba="0.8 0.8 0.8 1"/>
  </worldbody>
</mujoco>





